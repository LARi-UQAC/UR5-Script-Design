etalement_settings.json

# .etalement_export_state.json: empreinte du dernier .script / .urp genere,
# pour detecter qu'un fichier de sortie a ete retouche a la main avant de
# l'ecraser. Etat local d'un poste, sans interet pour un autre.
.etalement_export_state.json
