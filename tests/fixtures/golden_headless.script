def etalement():
  set_tcp(p[0.0, 0.0, 0.2657, 0, 0, 0])
  # Aucune pose home absolue : la position de depart est la pose courante
  # du robot (mesuree a l'execution). L'operateur jogge le robot ou il
  # veut, clique Start, et le sondage de surface part de la.
  home = get_actual_tcp_pose()
  probe_surface_z()

  cycle_1()
  cycle_2()
  cycle_3()
  cycle_4()
  cycle_5()
  cycle_6()
  movel(apply_correction(p[-0.011000, 0.534947, 0.080005, 3.141576, 0.000000, 0.000000]), a=URSCRIPT_ACCEL*ACCEL_FACTOR, v=0.2500*SPEED_FACTOR)
end

etalement()