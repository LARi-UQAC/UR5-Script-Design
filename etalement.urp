<program version="6.0">
  <robot acceleration="100" speed="100">
    <script># UR5 - Protocole etalement cosmetique
# Genere automatiquement par ur5_etalement.py
# IMPORTANT : calibrer ROBOT_X_ORIGIN, ROBOT_Y_ORIGIN, ROBOT_Z_SURFACE avant execution
#
# === PINCE 2F-85 : AUCUN ACTIONNEMENT ===
# Ce programme n a pas de commande de pince. La 2F-85 est un support
# passif pour le doigt silicone ; seule sa longueur (TCP_GRIPPER_Z=145 mm)
# entre dans set_tcp(). Aucun rq_activate / rq_* / RS485 outil / set_payload.
# Erreur PolyScope "wait for activation completed" au chargement = URCap
# Robotiq Grippers de l INSTALLATION du robot (auto-activation BeforeStart),
# pas ce fichier. Corriger sur le robot : Installation &gt; URCaps/Gripper &gt;
# desactiver l auto-activation, ou retirer le URCap, ou charger sur une
# installation sans pince.
#

# --- Ancre de la zone d'etalement ---
global P_REF = p[-0.011, 0.6, 0.05, 3.14159, 0.0, 0.0]

# --- Vitesses (m/s) par phase ---
# Note : URSCRIPT_MAX_TCP_SPEED (limite PolyScope, 0.25 m/s) n'est pas
# emis ici ; il est applique par le controleur. La vitesse de transit
# est inlinee directement sur les movel de transit.
global URSCRIPT_CONTACT_V = 0.0500  #sym:URSCRIPT_CONTACT_V
global URSCRIPT_RECONTACT_V = 0.0100  #sym:URSCRIPT_RECONTACT_V
global V_CIRC = 0.0360  #sym:CIRC_SPEED
global V_RECT = 0.0800  #sym:LIN_SPEED

# --- Accelerations (m/s^2) par phase ---
global URSCRIPT_ACCEL = 0.8  #sym:URSCRIPT_ACCEL
global A_INIT = 1.2  #sym:A_INIT

# --- Facteurs multiplicateurs globaux ---
global SPEED_FACTOR = 1.0
global ACCEL_FACTOR = 1.0
global URSCRIPT_BLEND = 0.002  #sym:URSCRIPT_BLEND

# --- Sondage de surface (plan 3 points + frame mesure) ---
global PROBE_FORCE_THR    = 4.0
global PROBE_DESCENT_V    = 0.0040
global PROBE_ACCEL        = 0.05
global PROBE_TILT_MAX_RAD = 0.0873
global NHAT_X = 0.000000000
global NHAT_Y = 0.000013447
global NHAT_Z = 1.000000000
global NOMINAL_FRAME = p[-0.011000, 0.592930, 0.050004, 3.141576, 0.000000, 0.000000]
global MEAS_FRAME = p[-0.011000, 0.592930, 0.050004, 3.141576, 0.000000, 0.000000]
global NOMINAL_P1_X = -0.011000
global NOMINAL_P1_Y = 0.592930
global NOMINAL_P1_Z = 0.050004
global NOMINAL_P2_X = -0.039284
global NOMINAL_P2_Y = 0.564646
global NOMINAL_P2_Z = 0.050005
global NOMINAL_P3_X = 0.003142
global NOMINAL_P3_Y = 0.550504
global NOMINAL_P3_Z = 0.050005
global contact_found = False
global contact_pose = p[0,0,0,0,0,0]

def probe_one(approach_pose, floor_pose, label):
  attempt = 0
  while attempt &lt;= 1:
    contact_found = False
    movel(approach_pose, a=A_INIT*ACCEL_FACTOR, v=0.2500*SPEED_FACTOR)
    sleep(0.4)
    zero_ftsensor()
    sleep(0.2)
    # CB3 (PolyScope 3.x) : stopl/movel interdits dans un thread. La descente
    # surveillee se fait dans le thread principal avec speedl (non bloquant)
    # + lecture de force + stopl. get_tcp_force() lu en entier puis norme des
    # 3 composantes lineaires calculee a la main (pas de slice [0:3], absent
    # du parser CB3 ; introduit seulement sur e-Series / PolyScope 5.x).
    ddx = floor_pose[0] - approach_pose[0]
    ddy = floor_pose[1] - approach_pose[1]
    ddz = floor_pose[2] - approach_pose[2]
    dnrm = sqrt(ddx*ddx + ddy*ddy + ddz*ddz)
    ux = ddx / dnrm
    uy = ddy / dnrm
    uz = ddz / dnrm
    f_norm = 0.0
    proj = 0.0
    while f_norm &lt;= PROBE_FORCE_THR and proj &lt; dnrm:
      speedl([ux*PROBE_DESCENT_V, uy*PROBE_DESCENT_V, uz*PROBE_DESCENT_V, 0, 0, 0], PROBE_ACCEL, 0.05)
      F_tcp = get_tcp_force()
      f_norm = sqrt(F_tcp[0]*F_tcp[0] + F_tcp[1]*F_tcp[1] + F_tcp[2]*F_tcp[2])
      cur = get_actual_tcp_pose()
      proj = (cur[0]-approach_pose[0])*ux + (cur[1]-approach_pose[1])*uy + (cur[2]-approach_pose[2])*uz
    end
    stopl(2.0)
    if f_norm &gt; PROBE_FORCE_THR:
      contact_pose = get_actual_tcp_pose()
      contact_found = True
    end
    if contact_found:
      textmsg(label, " contact OK")
      return contact_pose
    end
    textmsg(label, " contact NOK, retry attempt=", attempt+1)
    attempt = attempt + 1
  end
  popup("Probe failed - aucun contact detecte", "Verifier echantillon/calibration", error=True)
  halt
end

def probe_surface_plane():
  textmsg("&gt;&gt;&gt; Sondage de la surface : 3 points")
  cp1 = probe_one(p[-0.011000, 0.592930, 0.080004, 3.141576, 0.000000, 0.000000], p[-0.011000, 0.592930, 0.040004, 3.141576, 0.000000, 0.000000], "P1")
  cp2 = probe_one(p[-0.039284, 0.564646, 0.080005, 3.141576, 0.000000, 0.000000], p[-0.039284, 0.564646, 0.040005, 3.141576, 0.000000, 0.000000], "P2")
  cp3 = probe_one(p[0.003142, 0.550504, 0.080005, 3.141576, 0.000000, 0.000000], p[0.003142, 0.550504, 0.040005, 3.141576, 0.000000, 0.000000], "P3")
  v12x = cp2[0] - cp1[0]
  v12y = cp2[1] - cp1[1]
  v12z = cp2[2] - cp1[2]
  v13x = cp3[0] - cp1[0]
  v13y = cp3[1] - cp1[1]
  v13z = cp3[2] - cp1[2]
  nx = v12y*v13z - v12z*v13y
  ny = v12z*v13x - v12x*v13z
  nz = v12x*v13y - v12y*v13x
  nrm = sqrt(nx*nx + ny*ny + nz*nz)
  nx = nx / nrm
  ny = ny / nrm
  nz = nz / nrm
  dot_nom = NHAT_X*nx + NHAT_Y*ny + NHAT_Z*nz
  if dot_nom &lt; 0:
    nx = -nx
    ny = -ny
    nz = -nz
    dot_nom = -dot_nom
  end
  ax = NHAT_Y*nz - NHAT_Z*ny
  ay = NHAT_Z*nx - NHAT_X*nz
  az = NHAT_X*ny - NHAT_Y*nx
  anrm = sqrt(ax*ax + ay*ay + az*az)
  ang = atan2(anrm, dot_nom)
  if ang &gt; PROBE_TILT_MAX_RAD:
    textmsg("Tilt mesure (rad) = ", ang)
    popup("Plan mesure trop incline", "ang &gt; PROBE_TILT_MAX_RAD - verifier installation/calibration", error=True)
    halt
  end
  # Litteral decimal explicite (pas de notation scientifique 1.0e-9) :
  # certaines versions du parser URScript CB3 sont tatillonnes sur les
  # exposants ; la forme decimale est acceptee partout.
  if anrm &gt; 0.000000001:
    ax = ax / anrm
    ay = ay / anrm
    az = az / anrm
  else:
    ax = 0.0
    ay = 0.0
    az = 0.0
  end
  pose_rot   = p[cp1[0], cp1[1], cp1[2], ax*ang, ay*ang, az*ang]
  pose_orient = p[0, 0, 0, NOMINAL_FRAME[3], NOMINAL_FRAME[4], NOMINAL_FRAME[5]]
  MEAS_FRAME = pose_trans(pose_rot, pose_orient)
  textmsg("Surface tilt (rad) = ", ang)
  textmsg("MEAS_FRAME origin Z (m) = ", cp1[2])
end

def apply_correction(p_world):
  return pose_trans(MEAS_FRAME, pose_trans(pose_inv(NOMINAL_FRAME), p_world))
end

def cycle_1():
  # --- Cycle 1 - Circulaire (0deg) ---
  movel(apply_correction(p[-0.014536, 0.589394, 0.060004, 3.141576, 0.000000, 0.000000]), a=URSCRIPT_ACCEL*ACCEL_FACTOR, v=0.2500*SPEED_FACTOR)
  sleep(0.2)
  zero_ftsensor()
  sleep(0.2)
  force_mode(MEAS_FRAME, [0, 0, 1, 0, 0, 0], [0, 0, -6.0, 0, 0, 0], 2, [0.002, 0.002, 0.04, 0.35, 0.35, 0.35])
  movel(apply_correction(p[-0.014536, 0.589394, 0.045004, 3.141576, 0.000000, 0.000000]), a=URSCRIPT_ACCEL*ACCEL_FACTOR, v=URSCRIPT_RECONTACT_V*SPEED_FACTOR)
  movel(apply_correction(p[-0.014536, 0.589394, 0.050004, 3.141576, 0.000000, 0.000000]), a=URSCRIPT_ACCEL*ACCEL_FACTOR, v=V_CIRC*SPEED_FACTOR, r=URSCRIPT_BLEND)
  movel(apply_correction(p[-0.012753, 0.595816, 0.050004, 3.141576, 0.000000, 0.000000]), a=URSCRIPT_ACCEL*ACCEL_FACTOR, v=V_CIRC*SPEED_FACTOR, r=URSCRIPT_BLEND)
